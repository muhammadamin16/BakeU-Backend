{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2025"],
    "types": ["node"],
    "module": "node16",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
