# Copy to .env and fill in your values.
PORT=8080

# MongoDB connection (Atlas free M0 cluster, or local mongo)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bakeu

# Secret used to sign auth JWTs — use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Enable opt-in Go API refresh sessions for clients that implement rotation.
AUTH_REFRESH_SESSIONS=false
# Comma-separated exact HTTPS website origins for browser refresh cookies.
AUTH_BROWSER_ORIGINS=

# Shared Telegram bot bridge; same protected secret in bot and Go, never VITE_.
TELEGRAM_BRIDGE_TOKEN=
# Must match the bot MINI_APP_URL exactly (website origin/path).
TELEGRAM_SITE_URL=https://bakeu-website-production.up.railway.app
