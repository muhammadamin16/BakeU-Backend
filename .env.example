# Copy to .env and fill in your values.
PORT=8080

# MongoDB connection (Atlas free M0 cluster, or local mongo)
# URI options do not turn standalone into a replica set. Transaction-backed
# auth/checkout requires a real initialized writable replica set or mongos.
# /readyz stays503 until it is ready; see docs/production/MONGODB_READINESS.md.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bakeu

# Secret used to sign auth JWTs — use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Enable opt-in Go API refresh sessions for clients that implement rotation.
AUTH_REFRESH_SESSIONS=false
# Comma-separated exact HTTPS website origins for browser refresh cookies.
AUTH_BROWSER_ORIGINS=

# Coordinated opt-in after deploying the Go phone API, bot and website.
# Replaces unverified signup with Telegram own-contact + one-time-code proof.
# v2 uses firstName/lastName, no email/password, and required seller address/lat/lng.
# Rehearse the optional-email index transition first; see docs/production/PHONE_ONLY_AUTH.md.
AUTH_PHONE_ACCOUNTS=false
TELEGRAM_BOT_USERNAME=BakeUuzBot

# Shared Telegram bot bridge; same protected secret in bot and Go, never VITE_.
TELEGRAM_BRIDGE_TOKEN=
# Must match the bot MINI_APP_URL exactly (website origin/path).
TELEGRAM_SITE_URL=https://bakeu-website-production.up.railway.app

# Deliberate business change: verified buyers may activate their OWN new/draft shop.
# Preserve pending/rejected/suspended moderation. Enable only after reviewed rollout.
SELLER_SELF_SERVICE=false
# Exact immutable Go user IDs; comma-separated. Requires active verified phone.
# This is independent of the bot ADMIN_IDS (Telegram IDs) and ADMIN_EMAILS.
ADMIN_USER_IDS=
